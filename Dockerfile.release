# NamRA Voting: image for the PREBUILT release package (voting-app-release.zip). Nothing is compiled here:
# client/dist and server/dist are already in the package, built for BASE_PATH=/voting-app. This only installs the runtime packages.
# (The source-checkout image is ./Dockerfile; scripts/make-release.py puts this file in as the one docker-compose.yml builds.)
FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=8080 BASE_PATH=/voting-app UPLOAD_DIR=/data/uploads
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/
COPY client/package.json client/
# runtime packages only (native modules such as sharp are fetched for this Linux image)
RUN npm ci --omit=dev --workspace server --include-workspace-root=false --no-audit --no-fund
COPY server/dist server/dist
COPY server/migrations server/migrations
COPY client/dist client/dist
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
EXPOSE 8080
# 200 only when the app is up AND the database answers.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+(process.env.BASE_PATH||'')+'/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "server/dist/index.js"]
