{
  "name": "namra-voting",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev-lan.mjs",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "test": "npm test -w server && npm test -w client",
    "build": "npm run build -w client && npm run build -w server",
    "db:up": "docker compose up -d --wait",
    "umoja:import": "npm run umoja:import -w server --",
    "umoja:match": "npm run umoja:match -w server --"
  }
}
