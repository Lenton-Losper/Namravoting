{
  // Demo deployment only. Secrets (SESSION_SECRET, DATABASE_URL, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) are set with
  // `wrangler secret put` and never written here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namra-voting-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  "containers": [
    {
      "class_name": "NamraContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,          // rate limits live in memory, so exactly one instance
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "NamraContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NamraContainer"] }],

  // Non-secret configuration.
  "vars": {
    "NODE_ENV": "production",
    "AUTH_MODE": "entra",
    "STORAGE": "r2",
    "R2_BUCKET": "namra-voting-photos",
    "PUBLIC_BASE_URL": "https://namra-voting-demo.llosperofficial.workers.dev",
    "ENTRA_TENANT_ID": "fe7b029e-7e19-4525-bdf4-57462a59d299",
    "ENTRA_CLIENT_ID": "281ab38e-9ff5-4f17-88ea-18bdc3e65457",
    "ENTRA_REDIRECT_URI": "https://namra-voting-demo.llosperofficial.workers.dev/auth/callback",
    "ADMIN_EMAILS": "lenton.losper@namra.org.na",
    "DEMO_MEMBER_EMAILS": "lenton.losper@namra.org.na",
    // Required while DEMO_MEMBER_EMAILS is set: the app refuses to start in production with the override unless DEMO=true.
    "DEMO": "true",
    // Set these (docs/operations.md): admins by Entra object id, and the date the Entra client secret expires.
    // "ADMIN_OIDS": "",
    // "ENTRA_SECRET_EXPIRES_AT": "2027-01-31",
    "CF_ACCESS_TEAM_DOMAIN": "yellow-flower-4592.cloudflareaccess.com",
    "SLEEP_AFTER_MINUTES": "60"
  },
  // SEC-19: no per-request log lines. They would record every ballot URL (it contains the share token) with its exact time, and
  // vote timing is something we deliberately do not keep. Errors and console output are still logged.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
