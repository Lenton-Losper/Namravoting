{
  // Live deployment (Microsoft Entra sign-in). Secrets (SESSION_SECRET, DATABASE_URL, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY) are set with
  // `wrangler secret put` and never written here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namra-voting-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  "containers": [
    {
      "class_name": "NamraContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "max_instances": 1,          // rate limits live in memory, so exactly one instance
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "NamraContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NamraContainer"] }],

  // Non-secret configuration.
  "vars": {
    "NODE_ENV": "production",
    "AUTH_MODE": "entra",         // Microsoft sign-in. (email-demo, the typed-email demo sign-in, is still in the code but is off: docs/operations.md)
    "STORAGE": "r2",
    "R2_BUCKET": "namra-voting-photos",
    "PUBLIC_BASE_URL": "https://namra-voting-demo.llosperofficial.workers.dev",
    "ENTRA_TENANT_ID": "fe7b029e-7e19-4525-bdf4-57462a59d299",
    "ENTRA_CLIENT_ID": "281ab38e-9ff5-4f17-88ea-18bdc3e65457",
    // The redirect URI is PUBLIC_BASE_URL + BASE_PATH + /auth/callback (there is no ENTRA_REDIRECT_URI setting to keep in step with it).
    // It must be registered in the Entra app registration: https://namra-voting-demo.llosperofficial.workers.dev/auth/callback
    "ADMIN_EMAILS": "lenton.losper@namra.org.na",
    // No DEMO / DEMO_MEMBER_EMAILS here: nobody is a member by an email override in the live site. (The app refuses to start with
    // DEMO_MEMBER_EMAILS in production without DEMO=true, so a stray one cannot slip back in unnoticed.)
    // Admins by Entra object id (docs/operations.md). Once set, ADMIN_EMAILS is no longer used to grant admin rights.
    "ADMIN_OIDS": "87a4af90-dd00-48c6-9601-17e56248c9e1",
    // The date the new Entra client secret expires (YYYY-MM-DD, from Entra -> Certificates & secrets): admins are warned 30 days before,
    // and so is the Monitor workflow. SET THIS when the new secret is made (docs/operations.md, switch-back step 3). Also set the repository
    // variable of the same name for the Monitor.
    // "ENTRA_SECRET_EXPIRES_AT": "YYYY-MM-DD",
    // Staff notifications by email: the mailbox they are sent from. Needs the Graph application permission Mail.Send (IT grants it).
    // Unset = the Notify panel says email is not set up. See docs/business-logic-decisions.md (item 7).
    // "NOTIFY_SENDER": "voting@namra.org.na",
    "CF_ACCESS_TEAM_DOMAIN": "yellow-flower-4592.cloudflareaccess.com",
    "SLEEP_AFTER_MINUTES": "60"
  },
  // SEC-19: no per-request log lines. They would record every ballot URL (it contains the share token) with its exact time, and
  // vote timing is something we deliberately do not keep. Errors and console output are still logged.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
