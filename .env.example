# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3001
# "dev" = stubbed login (refused when NODE_ENV=production). Entra ID comes later.
AUTH_MODE=dev
# Required for AUTH_MODE=dev (the identity picker lets the browser claim any identity). `npm run dev` sets it for you.
ALLOW_DEV_AUTH=true
# Public base URL used inside QR codes / posters (the Vite dev server in dev).
PUBLIC_BASE_URL=http://localhost:5173
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-change-me-change-me-change-me
# Owner connection: used ONLY by the migration runner and seed.
MIGRATE_DATABASE_URL=postgres://namra_owner:namra_owner_dev@localhost:5433/namra
# Restricted app role (created by migration 003). The server connects with this.
DATABASE_URL=postgres://namra_app:namra_app_dev@localhost:5433/namra
APP_DB_PASSWORD=namra_app_dev
# Photo storage, outside any static folder.
UPLOAD_DIR=./uploads
VOTE_RATE_LIMIT_PER_MIN=10
ADMIN_RATE_LIMIT_PER_MIN=60

# --- Cloudflare demo deployment (fill in .env, never commit real values) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=namra-voting-photos
# Demo database on Neon (owner role for migrations/seed; restricted app role for the server)
DEMO_OWNER_DATABASE_URL=
DEMO_DATABASE_URL=
NEON_API_KEY=
# Storage backend: disk (dev/tests) or r2 (demo)
STORAGE=disk
# Required when AUTH_MODE=demo in production (Cloudflare Access)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ======================================================================================================================
# PRODUCTION on the NamRA VM (HOSTING.md). Copy this file to .env and replace EVERY value below. Never commit .env.
# Docker Compose reads $ in values: avoid the $ character in passwords (or write it as $$).
# ======================================================================================================================
# NODE_ENV=production                         # set by docker-compose.yml / the systemd unit; AUTH_MODE=dev is refused in production
# AUTH_MODE=entra                             # Microsoft sign-in (needs the ENTRA_* values below)
# PUBLIC_BASE_URL=https://apps.namra.org.na # the public ORIGIN only: no path. The app adds BASE_PATH itself.
# BASE_PATH=/voting-app                       # Node install only: Docker gets it from docker-compose.yml. Must match the client build (HOSTING.md)
# TRUST_PROXY=1                               # number of reverse proxies in front of the app (nginx / IIS): 1. Needed for per-visitor rate limits.
# SESSION_SECRET=                             # 48+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# PostgreSQL 16+ (HOSTING.md section 1). Two roles: the owner (migrations only) and namra_app (what the running app uses).
# MIGRATE_DATABASE_URL=postgres://namra_owner:OWNER_PASSWORD@DB_HOST:5432/namra
# DATABASE_URL=postgres://namra_app:APP_PASSWORD@DB_HOST:5432/namra
# APP_DB_PASSWORD=APP_PASSWORD                # the same password as in DATABASE_URL
# POSTGRES_PASSWORD=                          # only for the optional Docker database (--profile localdb): the password of its postgres superuser
# DB_SSL_CA=                                  # path to the CA certificate if the database server uses TLS with a private CA
# DB_TLS=off                                  # ONLY for the Docker database (host "db") or a trusted private network without TLS. Default: TLS with certificate checks.
# Microsoft Entra ID sign-in (AUTH_MODE=entra)
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=                       # the secret VALUE (not the Secret ID) of the Entra app registration
# (the redirect URI is PUBLIC_BASE_URL + BASE_PATH + /auth/callback: it is built by the app, there is nothing to set. Register that address in Entra.)
# ENTRA_SECRET_EXPIRES_AT=2027-05-30          # its expiry date (YYYY-MM-DD): admins and the Monitor warn 30 days before
# ADMIN_OIDS=                                 # comma-separated Entra object ids of the campaign admins
# NOTIFY_SENDER=                              # optional: mailbox for staff reminder emails (needs Mail.Send)
