# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3001
# "dev" = stubbed login (refused when NODE_ENV=production). Entra ID comes later.
AUTH_MODE=dev
# Public base URL used inside QR codes / posters (the Vite dev server in dev).
PUBLIC_BASE_URL=http://localhost:5173
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-change-me-change-me-change-me
# Owner connection: used ONLY by the migration runner and seed.
MIGRATE_DATABASE_URL=postgres://namra_owner:namra_owner_dev@localhost:5433/namra
# Restricted app role (created by migration 003). The server connects with this.
DATABASE_URL=postgres://namra_app:namra_app_dev@localhost:5433/namra
APP_DB_PASSWORD=namra_app_dev
# Photo storage, outside any static folder.
UPLOAD_DIR=./uploads
VOTE_RATE_LIMIT_PER_MIN=10
ADMIN_RATE_LIMIT_PER_MIN=60

# --- Cloudflare demo deployment (fill in .env, never commit real values) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=namra-voting-photos
# Demo database on Neon (owner role for migrations/seed; restricted app role for the server)
DEMO_OWNER_DATABASE_URL=
DEMO_DATABASE_URL=
NEON_API_KEY=
# Storage backend: disk (dev/tests) or r2 (demo)
STORAGE=disk
# Required when AUTH_MODE=demo in production (Cloudflare Access)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
